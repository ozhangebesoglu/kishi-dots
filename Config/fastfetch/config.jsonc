{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",  // Küçük Arch logosu
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": "  ➜  ",
    "color": "yellow",  
    "key": {
        "width": 15
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "Pkgs  ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "Term  ",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "CPU   ",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "GPU   ",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "RAM   ",
      "keyColor": "yellow"
    },
    "break",
    "colors"
  ]
}
